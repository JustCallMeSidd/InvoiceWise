{
  "name": "invoicewise",
  "version": "1.0.0",
  "description": "InvoiceWise — Professional Standalone GST Billing Desktop App",
  "main": "main.js",
  "author": "InvoiceWise Intelligence",
  "scripts": {
    "start": "node server.js",
    "electron:start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win && copy \"dist\\InvoiceWise Setup 1.0.0.exe\" \".\\InvoiceWise Setup 1.0.0.exe\" && copy \"dist\\InvoiceWise 1.0.0.exe\" \".\\InvoiceWise 1.0.0.exe\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.invoicewise.desktop",
    "productName": "InvoiceWise",
    "copyright": "Copyright © 2026 InvoiceWise",
    "files": [
      "main.js",
      "server.js",
      "prompts.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "InvoiceWise GST Billing",
      "uninstallDisplayName": "InvoiceWise Desktop"
    }
  }
}
